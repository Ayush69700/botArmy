# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud STT & TTS Credentials (optional for text-only, required for voice streaming)
GOOGLE_CLOUD_CREDENTIALS_PATH=./service-account.json

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/companion

# JWT Authentication Secret
JWT_SECRET=super_secret_companion_jwt_key_change_in_production

# Server Port
PORT=3001
